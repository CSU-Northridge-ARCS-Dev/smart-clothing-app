PORT=3001

# Fitbit app (Personal type) at dev.fitbit.com
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
# Must match a redirect URL registered on the Fitbit app exactly
FITBIT_REDIRECT_URI=https://<your-tunnel-domain>/api/fitbit/callback

# Claude feedback
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5
# Optional: where the token usage CSV goes (default: usage-log.csv here)
USAGE_LOG_PATH=

# Firebase project the app signs in to; verifyIdToken needs only this
FIREBASE_PROJECT_ID=

# Optional: comma-separated URL schemes the OAuth callback may redirect to
# Default: exp,exps,com.arcs.smartclothingapp
ALLOWED_RETURN_SCHEMES=
