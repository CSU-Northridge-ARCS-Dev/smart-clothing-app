{
  "name": "insights-service",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless backend for AI feedback: checks a day the phone built and asks Claude about it",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "try-coach": "node scripts/tryCoach.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__test__/**/*.test.js"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  }
}
